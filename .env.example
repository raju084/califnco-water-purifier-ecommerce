# Califnco Social & Notification Automation Configuration

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Meta Graph API (Instagram Professional / Creator Account)
INSTAGRAM_APP_NAME=Califnco Product Automation
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_ACCESS_TOKEN=your_meta_graph_api_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# WAHA (WhatsApp HTTP API) for WhatsApp Status
WAHA_ENDPOINT=http://localhost:3008
WAHA_SESSION=default

# Cron Schedule Expression (Default: 9:00 AM IST daily)
CRON_SCHEDULE=0 9 * * *
